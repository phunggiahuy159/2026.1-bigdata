# Giá trị giả để minh hoạ. Sao chép thành .env (đã gitignore) rồi điền giá trị thật;
# `make secrets` tạo K8s Secret từ .env. Không bao giờ commit .env.

# MinIO
MINIO_ROOT_USER=changeme-minio-user
MINIO_ROOT_PASSWORD=changeme-minio-password

# PostgreSQL (backend của Iceberg REST catalog)
POSTGRES_USER=iceberg
POSTGRES_PASSWORD=changeme-postgres-password
POSTGRES_DB=iceberg_catalog

# MongoDB
MONGODB_ROOT_PASSWORD=changeme-mongodb-password

# Redis
REDIS_PASSWORD=changeme-redis-password

# Google Safe Browsing (chỉ dùng trong labeling/)
SAFE_BROWSING_API_KEY=changeme-safe-browsing-key
